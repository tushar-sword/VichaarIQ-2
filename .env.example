# Safe template only. Copy to .env; never commit real keys or customer credentials.
# Keep OPENAI_API_KEY server-side; never use a NEXT_PUBLIC_ variable for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# LOCAL DEVELOPMENT ONLY: public sample metadata credentials, never for production.
# VichaarIQ's own metadata DB only; not a customer's analytics DB.
APP_DATABASE_URL=postgresql://vichaar:vichaar_dev_password@localhost:5433/vichaar_iq
